<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/DesignSystem/Resources/UI/Styles/DesignSystem/DesignSystem.uss" />
    <Style src="project://database/Assets/Resources/DsFonts/Poppins/Poppins.uss" />
    <ui:VisualElement name="root" class="ds-root ds-root--hud" style="flex-grow: 1; position: relative;">
        <ui:VisualElement name="main-menu-panel" class="ds-modal" style="position: absolute; right: 80px; top: 50%; translate: 0 -50%; width: 550px; padding: 48px;">
            <ui:Label name="title" text="Overclocked" class="ds-h1" style="font-size: 60px; margin-bottom: 32px;" />
            <ui:VisualElement class="ds-modal__actions" style="flex-direction: column;">
                <ui:Button name="start-btn" text="Start" class="ds-btn ds-btn--primary ds-btn--block ds-btn--lg" style="font-size: 28px; height: 64px; margin-bottom: 16px; -unity-text-align: middle-left; padding-left: 24px;" />
                <ui:Button name="tutorial-btn" text="Tutorial" class="ds-btn ds-btn--ghost ds-btn--block ds-btn--lg" style="font-size: 28px; height: 64px; margin-bottom: 16px; -unity-text-align: middle-left; padding-left: 24px;" />
                <ui:Button name="settings-btn" text="Settings" class="ds-btn ds-btn--ghost ds-btn--block ds-btn--lg" style="font-size: 28px; height: 64px; margin-bottom: 16px; -unity-text-align: middle-left; padding-left: 24px;" />
                <ui:Button name="about-btn" text="About" class="ds-btn ds-btn--ghost ds-btn--block ds-btn--lg" style="font-size: 28px; height: 64px; -unity-text-align: middle-left; padding-left: 24px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
